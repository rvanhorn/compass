{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "typescript-lsp@anthropic-plugin-directory": true
  },
  "enabledMcpjsonServers": [
    "codegraph"
  ],
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  }
}
